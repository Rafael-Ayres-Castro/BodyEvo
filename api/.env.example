# Copie para api/.env (local) ou cadastre no painel da hospedagem. Nunca vá para o git.

# Supabase › Project Settings › API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Seu usuário (Supabase › Authentication › Users › UID)
RUMO_USER_ID=

# Garmin Connect › Configurações › Personal API Token (connect.garmin.com/app/settings/personalApiToken)
GARMIN_API_KEY=

# Web Push: a pública vai em app.js (VAPID_PUBLICA); a privada só aqui
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Token que o GitHub Actions usa para chamar /internal/... (gere um aleatório)
INTERNAL_TOKEN=

# Origem do app (GitHub Pages)
ALLOWED_ORIGINS=https://rafael-ayres-castro.github.io
